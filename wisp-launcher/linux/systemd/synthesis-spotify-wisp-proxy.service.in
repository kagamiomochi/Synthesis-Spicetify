[Unit]
Description=Wisp proxy for Synthesis Spotify (starts the backend on demand)
Requires=synthesis-spotify-wisp-backend.service
After=synthesis-spotify-wisp-backend.service

[Service]
# Exits after being idle, which in turn stops the backend (StopWhenUnneeded).
ExecStart=@PROXYD@ --exit-idle-time=5min 127.0.0.1:6002
